# FolioTrack Server Configuration
PORT=3000
NODE_ENV=development

# Database
DB_PATH=data/foliotrack.db

# Security & Cryptography
JWT_SECRET=foliotrack-super-secret-jwt-key-change-in-production-min32chars
SETTINGS_ENCRYPTION_KEY=foliotrack-encryption-secret-key-32chars
JWT_EXPIRES_IN=7d

# Initial Admin User Seed
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@foliotrack.local
ADMIN_PASSWORD=admin123

# CORS & CSP
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
USE_HTTPS=false

