# ==============================================================================
# FolioTrack - Environment Configuration & Security Guide
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development # Set to 'production' when deploying on a public server

# Database Location
DB_PATH=data/foliotrack.db

# ------------------------------------------------------------------------------
# Security & Cryptography (CRITICAL FOR INTERNET EXPOSURE)
# ------------------------------------------------------------------------------
# Generate strong 64-character hex strings for production:
#   openssl rand -hex 32
JWT_SECRET=foliotrack-super-secret-jwt-key-change-in-production-min32chars
SETTINGS_ENCRYPTION_KEY=foliotrack-encryption-secret-key-32chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Initial Admin Account Seed
# (Only used on the very first boot if database has no users)
# IMPORTANT: Change credentials immediately in Settings -> "Sicurezza & Account"
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@foliotrack.local
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# Internet Exposure & Networking
# ------------------------------------------------------------------------------
# ALLOWED_ORIGINS: Comma-separated list of fully-qualified URLs allowed to connect via CORS.
# In production, set this to your exact domain(s), e.g. https://foliotrack.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set USE_HTTPS=true and/or COOKIE_SECURE=true when serving through SSL/TLS reverse proxy (NGINX, Caddy, Cloudflare)
USE_HTTPS=false
COOKIE_SECURE=false

# Trust proxy level for Express behind reverse proxy (1 = trust first hop, standard for Docker)
TRUST_PROXY=1
