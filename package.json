{
  "name": "foliotrack",
  "version": "1.0.0",
  "description": "Piattaforma self-hosted per il tracciamento avanzato di portafogli multi-asset",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_ENV=test ADMIN_USERNAME=admin ADMIN_PASSWORD=admin123 node --test test/**/*.test.js",
    "build:css": "tailwindcss -i ./public/input.css -o ./public/dist/style.css --minify",
    "watch:css": "tailwindcss -i ./public/input.css -o ./public/dist/style.css --watch",
    "db:reset": "node src/scripts/resetDatabase.js"
  },
  "keywords": [
    "portfolio",
    "finance",
    "tracker",
    "stocks",
    "etf",
    "crypto",
    "bonds"
  ],
  "author": "FolioTrack",
  "license": "ISC",
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "web-push": "^3.6.7",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
